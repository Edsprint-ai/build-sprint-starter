# Copy to .env and fill in. .env is gitignored and must never be committed.
# See docs/CLAUDE-SETUP.md for how to get a key and add credit.

# Leave this EMPTY to check that stage 3 works without it. It must.
ANTHROPIC_API_KEY=

# Pinned on purpose. Changing it changes your scores, so only change it by erratum.
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Set to "live" to bypass the response cache and make real calls.
# Default "cache" serves recorded responses and costs nothing.
AI_MODE=cache

DATABASE_URL=postgres://sprint:sprint@localhost:5432/sprint
PORT=3000
